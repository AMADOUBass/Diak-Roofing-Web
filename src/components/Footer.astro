---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-footer.png';
import { areas, services, site } from '../data/site';

const quickLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Gallery', href: '/gallery/' },
  { label: 'Financing', href: '/financing/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];

const columns = [
  { title: 'Company', links: quickLinks, wide: false },
  { title: 'Services', links: services, wide: false },
  // 14 towns: split over several columns so the footer stays short.
  { title: 'Service Areas', links: areas, wide: true },
];
---

<footer class="bg-ink pb-24 text-paper sm:pb-0">
  <div class="wrap grid gap-12 py-16 lg:grid-cols-[1.2fr_2fr]">
    <div class="grid content-start gap-5">
      <Image src={logo} alt={site.name} width={450} class="h-auto w-56" />
      <p class="max-w-xs text-paper/70">{site.tagline}</p>
      <ul class="grid gap-1">
        <li><a href={site.phoneHref} class="font-display text-2xl font-extrabold text-amber hover:underline">{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="break-all hover:underline">{site.email}</a></li>
        <li class="text-paper/70">{site.city} · {site.hours}</li>
      </ul>
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {site.social.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center font-semibold hover:text-amber">{s.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-[1fr_1.4fr_1.7fr]">
      {columns.map((col) => (
        <div class:list={[col.wide && "col-span-2 lg:col-span-1"]}>
          <h2 class:list={["mb-3 text-xs font-bold uppercase tracking-widest text-amber", col.wide && "max-sm:hidden"]}>{col.title}</h2>
          {col.wide && (
            <button type="button" data-areas-toggle aria-expanded="true" aria-controls="footer-areas" class="group flex min-h-12 w-full items-center justify-between border-y border-paper/15 font-display text-xs font-bold uppercase tracking-widest text-amber sm:hidden">
              {col.title} ({col.links.length})
              <svg class="size-4 transition-transform group-aria-expanded:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 4l4 4 4-4" /></svg>
            </button>
          )}
          <ul id={col.wide ? "footer-areas" : undefined} class:list={["grid gap-x-6 gap-y-0.5", col.wide && "grid-cols-2 max-sm:mt-3 max-sm:data-[collapsed]:hidden sm:grid-cols-4 lg:grid-cols-2"]}>
            {col.links.map((link) => (
              <li><a href={link.href} class="inline-flex min-h-9 items-center text-paper/80 hover:text-paper hover:underline">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="border-t border-paper/15">
    <div class="wrap flex flex-wrap justify-between gap-2 py-5 text-sm text-paper/60">
      <p>© {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
      <a href="/privacy-policy/" class="hover:text-paper hover:underline">Privacy Policy</a>
    </div>
  </div>
</footer>

<!-- Fixed call button on phones -->
<a href={site.phoneHref} class="btn btn-primary fixed inset-x-4 bottom-4 z-40 shadow-xl sm:hidden">Call {site.phone}</a>

<script>
  // On phones the 14 towns start folded behind a button; the links stay in the page either way.
  const toggle = document.querySelector<HTMLElement>('[data-areas-toggle]');
  const list = document.getElementById('footer-areas');

  if (toggle && list) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      list.toggleAttribute('data-collapsed', !open);
    };
    setOpen(false);
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  }
</script>
